                          aes(x = relative_abundance, y = reorder(species, relative_abundance),
                              fill = sample)) +
      geom_col(position = position_dodge(0.8), width = 0.7) +
      scale_fill_manual(values = palette_samples) +
      scale_x_continuous(labels = function(x) paste0(x, "%")) +
      labs(
        title    = "MetaPhlAn4 Species-level Abundance Profile",
        subtitle = "Marker gene-based approach (~5.1M unique clade-specific markers)",
        x = "Relative Abundance (%)", y = NULL, fill = "Sample"
      ) +
      theme_minimal(base_size = 12) +
      theme(
        plot.title = element_text(face = "bold"),
