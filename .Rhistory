################################################################################
##                                                                            ##
##   METAGENOMIC TAXONOMIC PROFILING                                 ##
##   Dataset: Cuatro Ciénegas oasis, Mexican desert (Okie et al. 2020)       ##
##   Samples: JC1A (control mesocosm) & JP4D (fertilized pond)               ##
##                                                                            ##
################################################################################

# ============================================================
# SECTION 0: INSTALL & LOAD REQUIRED PACKAGES
# ============================================================

# Run this block once to install all dependencies
required_cran <- c(
  "tidyverse",    # data manipulation + ggplot2
  "vegan",        # diversity indices (alpha/beta)
  "ggplot2",      # plotting
  "patchwork",    # combine ggplots
  "scales",       # axis formatting
  "RColorBrewer", # color palettes
  "pheatmap",     # heatmaps
  "ggalluvial",   # Sankey/alluvial plots (Pavian-style)
  "treemap",      # treemap visualizations
  "plotly",       # interactive plots (Krona-style)
  "htmlwidgets",  # save interactive plots
  "reshape2",     # data reshaping
  "knitr",        # tables
  "DT"            # interactive datatables
)

required_bioc <- c(
  "phyloseq",     # microbiome data structures & analysis
  "microbiome",   # microbiome utilities
  "DESeq2",       # differential abundance
  "biomformat"    # BIOM file parsing
)

# Install CRAN packages if missing
new_cran <- required_cran[!(required_cran %in% installed.packages()[,"Package"])]
if (length(new_cran)) install.packages(new_cran, dependencies = TRUE)

# Install Bioconductor packages if missing
if (!requireNamespace("BiocManager", quietly = TRUE))
  install.packages("BiocManager")
new_bioc <- required_bioc[!(required_bioc %in% installed.packages()[,"Package"]
                            )]
if (length(new_bioc)) BiocManager::install(new_bioc)

# Load all packages
suppressPackageStartupMessages({
  library(tidyverse)
  library(vegan)
  library(ggplot2)
  library(patchwork)
  library(scales)
  library(RColorBrewer)
