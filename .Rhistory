       p_phylum, width = 9, height = 6, dpi = 150)
cat("  ✓ Plot 2: Phylum composition\n")

# ────────────────────────────────────────────────────────────
# PLOT 3: Class-level Comparison (Pavian-style comparison)
# ────────────────────────────────────────────────────────────

top_classes <- class_comp %>%
  group_by(class) %>%
  summarise(total = sum(pct_reads)) %>%
  arrange(desc(total)) %>%
  slice_head(n = 12) %>%
  pull(class)

class_wide <- class_comp %>%
  filter(class %in% top_classes) %>%
  pivot_wider(names_from = sample, values_from = pct_reads, values_fill = 0) %>%
  arrange(desc(rowSums(across(where(is.numeric)))))

class_long <- class_comp %>%
  filter(class %in% top_classes) %>%
  mutate(class = factor(class, levels = rev(top_classes)))

p_class <- ggplot(class_long, aes(x = pct_reads, y = class, fill = sample)) +
  geom_col(position = position_dodge(0.8), width = 0.7) +
  scale_fill_manual(values = palette_samples) +
  scale_x_continuous(labels = percent_format(scale = 1)) +
  labs(
    title    = "Class-level Diversity Comparison",
    subtitle = "JC1A (control) vs JP4D (fertilized) — Kraken2",
    x = "% of Total Reads", y = NULL, fill = "Sample"
  ) +
  theme_minimal(base_size = 12) +
  theme(
    plot.title = element_text(face = "bold"),
    legend.position = "top",
    panel.grid.major.y = element_blank()
  )

ggsave(file.path(config$out_dir, "03_class_comparison.pdf"),
       p_class, width = 10, height = 7)
ggsave(file.path(config$out_dir, "03_class_comparison.png"),
       p_class, width = 10, height = 7, dpi = 150)
cat("  ✓ Plot 3: Class-level comparison\n")

# ────────────────────────────────────────────────────────────
# PLOT 4: Sankey Diagram — Taxonomy Flow (Pavian-style)
# ────────────────────────────────────────────────────────────

build_sankey_data <- function(report, sample_name) {
  # Extract hierarchical flow: Domain → Phylum → Class
  domain_data <- report %>% filter(rank == "D") %>%
    mutate(name = str_trim(name), level = "Domain")
  
  phylum_data <- report %>% filter(rank == "P") %>%
    mutate(name = str_trim(name), level = "Phylum")
  
  class_data <- report %>% filter(rank == "C") %>%
    mutate(name = str_trim(name), level = "Class") %>%
    head(8)
  
  # Build alluvial format
  if (nrow(domain_data) > 0 && nrow(phylum_data) > 0 && nrow(class_data) > 0) {
    
    total <- report %>% filter(rank == "U") %>% pull(clade_reads) %>% sum() +
      report %>% filter(rank == "R") %>% pull(clade_reads) %>% sum()
    
    # Simplified: assign phyla to known domains
    alluvial_data <- class_data %>%
      mutate(
        domain = case_when(
          name %in% c("Alphaproteobacteria","Betaproteobacteria","Gammaproteobacteria") ~ "Bacteria",
          name %in% c("Actinomycetia","Flavobacteriia","Bacteroidia") ~ "Bacteria",
          TRUE ~ "Bacteria"
        ),
        phylum = case_when(
          name %in% c("Alphaproteobacteria","Betaproteobacteria","Gammaproteobacteria") ~ "Proteobacteria",
          name %in% c("Flavobacteriia","Bacteroidia") ~ "Bacteroidetes",
          name == "Actinomycetia" ~ "Actinobacteria",
          TRUE ~ "Other_Phylum"
        ),
        freq = clade_reads / total * 100,
        sample = sample_name
      )
    return(alluvial_data)
  }
  return(NULL)
}

sankey_JC1A <- build_sankey_data(kraken_JC1A, "JC1A")
sankey_JP4D <- build_sankey_data(kraken_JP4D, "JP4D")

if (!is.null(sankey_JC1A) && nrow(sankey_JC1A) > 0) {
  sankey_data <- bind_rows(sankey_JC1A, sankey_JP4D)
  
  p_sankey <- ggplot(sankey_data,
                     aes(axis1 = domain, axis2 = phylum, axis3 = name, y = freq)) +
    geom_alluvium(aes(fill = domain), width = 1/12, alpha = 0.8) +
    geom_stratum(width = 1/12, fill = "white", color = "grey40", linewidth = 0.3) +
    geom_text(stat = "stratum", aes(label = after_stat(stratum)),
              size = 2.8, color = "grey20") +
    scale_fill_brewer(palette = "Set2") +
    scale_x_discrete(limits = c("Domain", "Phylum", "Class"),
                     expand = c(0.05, 0.05)) +
    facet_wrap(~sample, scales = "free_y") +
    labs(
      title    = "Taxonomic Flow: Domain → Phylum → Class",
      subtitle = "Sankey/Alluvial diagram (Pavian-style)",
      y        = "% of Total Reads",
      fill     = "Domain"
    ) +
    theme_minimal(base_size = 11) +
    theme(
      plot.title   = element_text(face = "bold"),
      legend.position = "bottom",
      axis.text.x = element_text(face = "bold")
    )
  
  ggsave(file.path(config$out_dir, "04_sankey_taxonomy.pdf"),
         p_sankey, width = 14, height = 8)
  ggsave(file.path(config$out_dir, "04_sankey_taxonomy.png"),
         p_sankey, width = 14, height = 8, dpi = 150)
  cat("  ✓ Plot 4: Sankey taxonomy flow diagram\n")
} else {
  cat("  ⚠ Plot 4: Insufficient data for Sankey (skipped).\n")
}

# ────────────────────────────────────────────────────────────
# PLOT 5: Interactive Krona-style Sunburst (Plotly)
# ────────────────────────────────────────────────────────────

build_sunburst_data <- function(report, sample_name) {
  total <- report %>% filter(rank == "U") %>% pull(clade_reads) %>% sum() +
    report %>% filter(rank == "R") %>% pull(clade_reads) %>% sum()
  
  # Extract hierarchical levels
  domain_rows <- report %>% filter(rank %in% c("U","D")) %>%
    mutate(label = str_trim(name), parent = "root",
           value = clade_reads / total * 100, id = str_trim(name))
  
  phylum_rows <- report %>% filter(rank == "P") %>%
    mutate(label = str_trim(name), parent = "Bacteria",
           value = clade_reads / total * 100, id = str_trim(name))
  
  class_rows <- report %>% filter(rank == "C") %>%
    mutate(label = str_trim(name), parent = "Proteobacteria",
           value = clade_reads / total * 100, id = str_trim(name)) %>%
    head(8)
  
  root <- tibble(label = "root", parent = "", value = 100,
                 id = "root", rank = "root", name = "root")
  
  bind_rows(root, domain_rows, phylum_rows, class_rows) %>%
    select(id, label, parent, value) %>%
    distinct(id, .keep_all = TRUE)
}

sunburst_JC1A <- build_sunburst_data(kraken_JC1A, "JC1A")
sunburst_JP4D <- build_sunburst_data(kraken_JP4D, "JP4D")

create_krona_sunburst <- function(sun_data, sample_name) {
  plot_ly(
    sun_data,
    ids     = ~id,
    labels  = ~label,
    parents = ~parent,
    values  = ~value,
    type    = "sunburst",
    branchvalues = "total",
    maxdepth = 3,
    hovertemplate = "<b>%{label}</b><br>%{value:.2f}%<extra></extra>"
  ) %>%
    layout(
      title = list(text = paste0("Taxonomic Composition — ", sample_name,
                                 "<br><sub>Krona-style interactive sunburst</sub>"),
                   font = list(size = 16)),
      colorway = brewer.pal(8, "Set2"),
      margin = list(t = 80, l = 20, r = 20, b = 20)
    )
}

krona_JC1A <- create_krona_sunburst(sunburst_JC1A, "JC1A")
krona_JP4D <- create_krona_sunburst(sunburst_JP4D, "JP4D")

saveWidget(krona_JC1A,
           file.path(normalizePath(config$out_dir), "05a_krona_JC1A.html"),
           selfcontained = TRUE, title = "Krona - JC1A")
saveWidget(krona_JP4D,
           file.path(normalizePath(config$out_dir), "05b_krona_JP4D.html"),
           selfcontained = TRUE, title = "Krona - JP4D")
cat("  ✓ Plot 5: Interactive Krona-style sunburst charts (HTML)\n")

