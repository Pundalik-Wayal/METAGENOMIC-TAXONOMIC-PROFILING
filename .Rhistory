  scale_y_continuous(labels = percent_format(scale = 1), limits = c(0, 110)) +
  geom_text(aes(label = sprintf("%.1f%%", Classified_pct)),
            position = position_dodge(0.7), vjust = -0.4, size = 4) +
  labs(
    title    = "Kraken2 vs MetaPhlAn: Classification Rate",
    subtitle = "Kraken2 classifies more reads; MetaPhlAn is more conservative & specific",
    x = "Sample", y = "% Reads Classified", fill = "Tool"
  ) +
  theme_minimal(base_size = 12) +
  theme(
    plot.title = element_text(face = "bold"),
    panel.grid.major.x = element_blank()
  )

ggsave(file.path(config$out_dir, "08_tool_comparison.pdf"),
       p_tool_compare, width = 8, height = 6)
ggsave(file.path(config$out_dir, "08_tool_comparison.png"),
       p_tool_compare, width = 8, height = 6, dpi = 150)
cat("  ✓ Plot 8: Tool comparison (Kraken2 vs MetaPhlAn)\n")

# ────────────────────────────────────────────────────────────
# PLOT 9: Alpha Diversity
# ────────────────────────────────────────────────────────────

# Build species abundance matrix for diversity analysis
build_otu_matrix <- function(kraken_report_list) {
  all_species <- map_dfr(names(kraken_report_list), function(samp) {
    kraken_report_list[[samp]] %>%
      filter(rank == "S") %>%
      mutate(name = str_trim(name), sample = samp) %>%
      select(sample, name, direct_reads)
  })
  
  if (nrow(all_species) == 0) return(NULL)
  
  otu_wide <- all_species %>%
    pivot_wider(names_from = sample, values_from = direct_reads, values_fill = 0) %>%
    column_to_rownames("name")
  
  return(otu_wide)
}

otu_matrix <- build_otu_matrix(list(JC1A = kraken_JC1A, JP4D = kraken_JP4D))

if (!is.null(otu_matrix) && ncol(otu_matrix) >= 2) {
  # Calculate alpha diversity metrics
  otu_t <- t(otu_matrix)
  
  alpha_div <- tibble(
    Sample    = rownames(otu_t),
    Richness  = specnumber(otu_t),          # Species richness (S)
    Shannon   = diversity(otu_t, "shannon"), # Shannon H'
    Simpson   = diversity(otu_t, "simpson"), # Simpson 1-D
    InvSimp   = diversity(otu_t, "inv"),     # Inverse Simpson
    Evenness  = diversity(otu_t, "shannon") / log(specnumber(otu_t)) # Pielou's J
  ) %>%
    mutate(Evenness = if_else(is.nan(Evenness), NA_real_, Evenness))
  
  cat("\n  Alpha Diversity Metrics:\n")
  print(alpha_div)
  
  # Visualize alpha diversity
  alpha_long <- alpha_div %>%
    pivot_longer(cols = -Sample, names_to = "Metric", values_to = "Value") %>%
    filter(!is.na(Value))
  
  p_alpha <- ggplot(alpha_long, aes(x = Sample, y = Value, fill = Sample)) +
    geom_col(width = 0.6, color = "white") +
    geom_text(aes(label = round(Value, 3)), vjust = -0.3, size = 3.5) +
    scale_fill_manual(values = palette_samples) +
    facet_wrap(~Metric, scales = "free_y", ncol = 3) +
    labs(
      title    = "Alpha Diversity Metrics",
      subtitle = "Richness, Shannon, Simpson, Evenness (species-level Kraken2 output)",
      x = NULL, y = "Value"
    ) +
    theme_minimal(base_size = 11) +
    theme(
      plot.title   = element_text(face = "bold"),
      legend.position = "none",
      strip.text   = element_text(face = "bold"),
      panel.grid.major.x = element_blank()
    )
  
  ggsave(file.path(config$out_dir, "09_alpha_diversity.pdf"),
         p_alpha, width = 10, height = 7)
  ggsave(file.path(config$out_dir, "09_alpha_diversity.png"),
         p_alpha, width = 10, height = 7, dpi = 150)
  cat("  ✓ Plot 9: Alpha diversity metrics\n")
  
  # ────────────────────────────────────────────────────────────
  # PLOT 10: Beta Diversity — Bray-Curtis dissimilarity
  # ────────────────────────────────────────────────────────────
  
  if (ncol(otu_matrix) >= 2) {
    bray_dist <- vegdist(otu_t, method = "bray")
    bray_mat  <- as.matrix(bray_dist)
    
    cat("\n  Bray-Curtis Dissimilarity Matrix:\n")
    print(round(bray_mat, 4))
    
    # Heatmap of dissimilarity
    p_beta <- pheatmap(
      bray_mat,
      color          = colorRampPalette(c("#E3F2FD","#1565C0"))(100),
      display_numbers = TRUE,
      number_format  = "%.3f",
      fontsize_number = 12,
      main           = "Bray-Curtis Dissimilarity\n(0 = identical, 1 = completely different)",
      filename       = file.path(config$out_dir, "10_beta_diversity_heatmap.pdf"),
      width = 5, height = 4
    )
    cat("  ✓ Plot 10: Beta diversity heatmap\n")
  }
  
  # ────────────────────────────────────────────────────────────
  # PLOT 11: Rarefaction Curves
  # ────────────────────────────────────────────────────────────
  
  tryCatch({
    max_depth <- min(rowSums(otu_t), config$rarefaction_depth)
    step_size <- max(1, floor(max_depth / 30))
    depths    <- seq(step_size, max_depth, by = step_size)
    
    raref_data <- map_dfr(depths, function(d) {
      map_dfr(rownames(otu_t), function(samp) {
        reads <- otu_t[samp, , drop = FALSE]
        if (sum(reads) >= d) {
          raref <- rarefy(reads, d)
          tibble(Sample = samp, Depth = d, Species = raref)
        } else {
          tibble(Sample = samp, Depth = d, Species = NA_real_)
        }
      })
    }) %>% filter(!is.na(Species))
    
    p_raref <- ggplot(raref_data, aes(x = Depth, y = Species, color = Sample)) +
      geom_line(linewidth = 1.2) +
      geom_point(data = raref_data %>% group_by(Sample) %>% slice_max(Depth, n=1),
                 size = 3) +
      scale_color_manual(values = palette_samples) +
      scale_x_continuous(labels = comma) +
      labs(
        title    = "Rarefaction Curves",
        subtitle = "Species richness as a function of sequencing depth",
        x = "Number of Reads Sampled", y = "Expected Species Richness",
        color = "Sample"
      ) +
      theme_minimal(base_size = 12) +
      theme(plot.title = element_text(face = "bold"))
    
    ggsave(file.path(config$out_dir, "11_rarefaction_curves.pdf"),
           p_raref, width = 8, height = 6)
    ggsave(file.path(config$out_dir, "11_rarefaction_curves.png"),
           p_raref, width = 8, height = 6, dpi = 150)
    cat("  ✓ Plot 11: Rarefaction curves\n")
  }, error = function(e) {
    cat(sprintf("  ⚠ Plot 11: Rarefaction skipped (%s)\n", conditionMessage(e)))
  })
}

# ────────────────────────────────────────────────────────────
# PLOT 12: Differential Abundance (DESeq2)
# ────────────────────────────────────────────────────────────

cat("\n══════════════════════════════════════════════\n")
cat("  STEP 6: Differential Abundance (DESeq2)\n")
cat("══════════════════════════════════════════════\n")

tryCatch({
  if (!is.null(otu_matrix) && ncol(otu_matrix) >= 2 && nrow(otu_matrix) >= 3) {
    
    # Keep only taxa present in at least 1 sample with >=5 reads
    otu_filtered <- otu_matrix[rowSums(otu_matrix) >= 5, ]
    
    if (nrow(otu_filtered) >= 3) {
      col_data <- data.frame(
        condition = c("control", "fertilized"),
        row.names = colnames(otu_filtered)
      )
      
      dds <- DESeqDataSetFromMatrix(
        countData = round(otu_filtered),
        colData   = col_data,
        design    = ~ condition
      )
      dds <- DESeq(dds, quiet = TRUE)
      res <- results(dds, contrast = c("condition", "fertilized", "control"),
                     alpha = 0.05)
      res_df <- as.data.frame(res) %>%
        rownames_to_column("species") %>%
        filter(!is.na(padj)) %>%
        arrange(padj) %>%
        mutate(
          significant = padj < 0.05 & abs(log2FoldChange) > 1,
          direction   = case_when(
            log2FoldChange > 1  ~ "Enriched in JP4D",
            log2FoldChange < -1 ~ "Depleted in JP4D",
            TRUE                ~ "Not significant"
          )
        )
      
      cat(sprintf("  Significant differentially abundant taxa: %d\n",
                  sum(res_df$significant, na.rm = TRUE)))
      
      # Volcano plot
      p_volcano <- ggplot(res_df,
                          aes(x = log2FoldChange, y = -log10(padj),
                              color = direction, label = species)) +
        geom_point(alpha = 0.7, size = 2.5) +
        geom_hline(yintercept = -log10(0.05), linetype = "dashed",
                   color = "grey50") +
        geom_vline(xintercept = c(-1, 1), linetype = "dashed",
                   color = "grey50") +
        scale_color_manual(values = c(
          "Enriched in JP4D"  = "#E91E63",
          "Depleted in JP4D"  = "#2196F3",
          "Not significant"   = "#9E9E9E"
        )) +
        labs(
          title    = "Differential Abundance: JP4D vs JC1A (DESeq2)",
          subtitle = "Volcano plot | Dashed lines: |log2FC|=1, padj=0.05",
          x = "log2(Fold Change)  [JP4D / JC1A]",
          y = "-log10(adjusted p-value)",
          color = NULL
        ) +
        theme_minimal(base_size = 12) +
        theme(
          plot.title = element_text(face = "bold"),
          legend.position = "top"
        )
      
      ggsave(file.path(config$out_dir, "12_differential_abundance.pdf"),
             p_volcano, width = 9, height = 7)
      ggsave(file.path(config$out_dir, "12_differential_abundance.png"),
             p_volcano, width = 9, height = 7, dpi = 150)
      cat("  ✓ Plot 12: Differential abundance volcano plot\n")
      
      # Save DESeq2 results table
      write_csv(res_df, file.path(config$out_dir, "deseq2_results.csv"))
    }
  }
}, error = function(e) {
  cat(sprintf("  ⚠ DESeq2 analysis skipped: %s\n", conditionMessage(e)))
})

# ============================================================
# SECTION 8: PHYLOSEQ OBJECT CONSTRUCTION
# ============================================================

cat("\n══════════════════════════════════════════════\n")
cat("  STEP 7: Building Phyloseq Object\n")
cat("══════════════════════════════════════════════\n")

tryCatch({
  if (!is.null(otu_matrix) && nrow(otu_matrix) >= 2) {
    
    # OTU table
    otu_ps <- otu_table(as.matrix(otu_matrix), taxa_are_rows = TRUE)
    
    # Sample metadata
    sam_data <- sample_data(metadata %>%
                              filter(SampleID %in% colnames(otu_matrix)) %>%
                              column_to_rownames("SampleID"))
    
    # Taxonomy table from Kraken reports
    taxa_names_all <- rownames(otu_matrix)
    
    # Build minimal taxonomy table
    tax_mat <- matrix(NA, nrow = length(taxa_names_all), ncol = 7,
                      dimnames = list(taxa_names_all,
                                      c("Kingdom","Phylum","Class","Order","Family","Genus","Species")))
    tax_mat[,"Species"] <- taxa_names_all
    
    # Fill in known lineages from Kraken reports
    known_lineages <- kraken_all %>%
      filter(rank == "S") %>%
      select(name) %>%
      distinct() %>%
      mutate(name = str_trim(name))
    
    tax_ps <- tax_table(tax_mat)
    
    # Construct phyloseq object
    ps <- phyloseq(otu_ps, sam_data, tax_ps)
    
    cat(sprintf("  ✓ Phyloseq object: %d taxa × %d samples\n",
                ntaxa(ps), nsamples(ps)))
    
    # Normalize to relative abundance
    ps_rel <- transform_sample_counts(ps, function(x) x / sum(x) * 100)
    
    # Save phyloseq object
    saveRDS(ps, file.path(config$out_dir, "phyloseq_object.rds"))
    cat("  ✓ Phyloseq object saved to phyloseq_object.rds\n")
  }
}, error = function(e) {
  cat(sprintf("  ⚠ Phyloseq construction skipped: %s\n", conditionMessage(e)))
})

