})

cat("✓ All packages loaded successfully.\n")

# ============================================================
# SECTION 1: CONFIGURATION — SET YOUR FILE PATHS HERE
# ============================================================

# ------------------------------------------------------------------
# OPTION A: Use real Kraken2 report files (produced externally)
#   Set paths to your Kraken2 report files (tab-separated, 6 columns)
#   and MetaPhlAn abundance files.
#
# OPTION B: The pipeline will auto-generate realistic simulated data
#   if files are not found (useful for testing and learning).
# ------------------------------------------------------------------

config <- list(
  
  # ── Kraken2 Report Files (6-column standard format) ──────────────
  kraken_JC1A  = "JC1A_kraken2_report.txt",
  kraken_JP4D  = "JP4D_kraken2_report.txt",
  
  # ── MetaPhlAn Abundance Files ─────────────────────────────────────
  metaphlan_JC1A = "JC1A_metaphlan_profile.txt",
  metaphlan_JP4D = "JP4D_metaphlan_profile.txt",
  
  # ── Metadata file ─────────────────────────────────────────────────
  metadata_file  = "metadata.tabular",
  
  # ── Output directory ──────────────────────────────────────────────
  out_dir        = "metagenomics_output",
  
  # ── Analysis parameters ───────────────────────────────────────────
  min_reads      = 10,       # minimum reads for filtering
  conf_threshold = 0.1,      # Kraken2 confidence score used
  top_n_taxa     = 20,       # taxa to show in bar charts
  rarefaction_depth = 5000   # reads for rarefaction
)

# Create output directory
dir.create(config$out_dir, showWarnings = FALSE, recursive = TRUE)
cat(sprintf("✓ Output directory: %s\n", config$out_dir))

# ============================================================
# SECTION 2: DATA SIMULATION (fallback if real files absent)
# ============================================================

simulate_kraken_report <- function(sample_name, total_reads, seed = 42) {
  # Simulates a realistic Kraken2 report based on tutorial findings:
  # ~77% unclassified for JC1A, ~90% for JP4D
  set.seed(seed)
  
  if (sample_name == "JC1A") {
    unclass_pct <- 76.85
    bacteria_pct <- 12.58
    eukaryota_pct <- 9.5
    virus_pct <- 0.03
  } else {
    unclass_pct <- 89.8
    bacteria_pct <- 9.22
    eukaryota_pct <- 0.7
    virus_pct <- 0.01
  }
  
  unclass_reads <- round(total_reads * unclass_pct / 100)
  classified_reads <- total_reads - unclass_reads
  
  # Build taxonomy table
  taxa <- tribble(
    ~pct,   ~clade_reads, ~direct_reads, ~rank, ~taxid, ~name,
    unclass_pct, unclass_reads, unclass_reads, "U", 0, "unclassified",
    100 - unclass_pct, classified_reads, round(classified_reads*0.04), "R", 1, "root",
    100 - unclass_pct - 0.5, round(classified_reads*0.96), round(classified_reads*0.01), "R1", 131567, "cellular organisms",
    bacteria_pct, round(total_reads*bacteria_pct/100), round(total_reads*bacteria_pct/100*0.15), "D", 2, "Bacteria",
    bacteria_pct*0.70, round(total_reads*bacteria_pct/100*0.70), round(total_reads*bacteria_pct/100*0.12), "P", 1224, "Proteobacteria",
    bacteria_pct*0.45, round(total_reads*bacteria_pct/100*0.45), round(total_reads*bacteria_pct/100*0.08), "C", 28211, "Alphaproteobacteria",
    bacteria_pct*0.10, round(total_reads*bacteria_pct/100*0.10), round(total_reads*bacteria_pct/100*0.04), "C", 1236, "Gammaproteobacteria",
    bacteria_pct*0.08, round(total_reads*bacteria_pct/100*0.08), round(total_reads*bacteria_pct/100*0.03), "C", 28216, "Betaproteobacteria",
    bacteria_pct*0.20, round(total_reads*bacteria_pct/100*0.20), round(total_reads*bacteria_pct/100*0.02), "P", 976, "Bacteroidetes",
    bacteria_pct*0.05, round(total_reads*bacteria_pct/100*0.05), round(total_reads*bacteria_pct/100*0.01), "P", 1760, "Actinobacteria",
    bacteria_pct*0.03, round(total_reads*bacteria_pct/100*0.03), round(total_reads*bacteria_pct/100*0.005), "C", 117743, "Flavobacteriia",
    eukaryota_pct, round(total_reads*eukaryota_pct/100), round(total_reads*eukaryota_pct/100*0.1), "D", 2759, "Eukaryota",
    eukaryota_pct*0.90, round(total_reads*eukaryota_pct/100*0.90), round(total_reads*eukaryota_pct/100*0.05), "K", 9606, "Homo sapiens",
    virus_pct, round(total_reads*virus_pct/100), round(total_reads*virus_pct/100*0.5), "D", 10239, "Viruses"
  )
  
  # Add species-level entries
  species_data <- tribble(
    ~pct, ~clade_reads, ~direct_reads, ~rank, ~taxid, ~name,
    bacteria_pct*0.08, round(total_reads*bacteria_pct/100*0.08), round(total_reads*bacteria_pct/100*0.07), "G", 265, "Paracoccus",
    bacteria_pct*0.04, round(total_reads*bacteria_pct/100*0.04), round(total_reads*bacteria_pct/100*0.04), "S", 52688, "Paracoccus pantotrophus",
    bacteria_pct*0.02, round(total_reads*bacteria_pct/100*0.02), round(total_reads*bacteria_pct/100*0.02), "S", 1076935, "Phycocomes zhengii",
    bacteria_pct*0.03, round(total_reads*bacteria_pct/100*0.03), round(total_reads*bacteria_pct/100*0.03), "S", 237609, "Candidatus Pelagibacter ubique"
  )
  
  report <- bind_rows(taxa, species_data) %>%
    mutate(sample = sample_name) %>%
    arrange(desc(clade_reads))
  
  return(report)
}

simulate_metaphlan_profile <- function(sample_name, seed = 42) {
  set.seed(seed)
  if (sample_name == "JC1A") {
    # Tutorial: JC1A had all reads unclassified in MetaPhlAn
    profile <- tibble(
      clade_name = character(0), ncbi_tax_id = character(0),
      relative_abundance = numeric(0), sample = character(0)
    )
  } else {
    profile <- tribble(
      ~clade_name, ~ncbi_tax_id, ~relative_abundance,
      "k__Bacteria", "2", 100.0,
      "k__Bacteria|p__Bacteroidetes", "2|976", 94.39,
      "k__Bacteria|p__Proteobacteria", "2|1224", 5.61,
      "k__Bacteria|p__Bacteroidetes|c__CFGB45935", "2|976|", 94.39,
      "k__Bacteria|p__Proteobacteria|c__Alphaproteobacteria", "2|1224|28211", 5.61,
      "k__Bacteria|p__Bacteroidetes|c__CFGB45935|o__OFGB45935|f__FGB45935|g__GGB56609|s__GGB56609_SGB78025", "2|976||||", 94.39,
      "k__Bacteria|p__Proteobacteria|c__Alphaproteobacteria|o__Rhodobacterales|f__Rhodobacteraceae|g__Phycocomes|s__Phycocomes_zhengii", "2|1224|28211|204455|31989|2873978|2056810", 5.61
    ) %>% mutate(sample = sample_name)
  }
  return(profile)
}

# ============================================================
# SECTION 3: DATA LOADING
# ============================================================

load_kraken_report <- function(filepath, sample_name) {
  if (file.exists(filepath)) {
    cat(sprintf("  Loading Kraken2 report: %s\n", filepath))
    report <- read_tsv(filepath,
                       col_names = c("pct", "clade_reads", "direct_reads", "rank", "taxid", "name"),
                       col_types = "dddcic",
                       comment = ""
    ) %>%
      mutate(
        name = str_trim(name),
        sample = sample_name
      )
    return(report)
  } else {
    cat(sprintf("  [Simulation] Kraken2 report not found for %s — using simulated data.\n", sample_name))
    total <- if (sample_name == "JC1A") 137198 else 298444
    return(simulate_kraken_report(sample_name, total, seed = if(sample_name=="JC1A") 1 else 2))
  }
}

load_metaphlan_profile <- function(filepath, sample_name) {
  if (file.exists(filepath)) {
    cat(sprintf("  Loading MetaPhlAn profile: %s\n", filepath))
    # Skip comment lines
    lines <- readLines(filepath)
    header_line <- which(grepl("^#clade_name", lines))
    if (length(header_line) > 0) {
      profile <- read_tsv(filepath, skip = header_line - 1,
                          col_types = cols(.default = "c")) %>%
        rename_with(tolower) %>%
        rename(clade_name = 1, ncbi_tax_id = 2, relative_abundance = 3) %>%
        mutate(relative_abundance = as.numeric(relative_abundance),
               sample = sample_name)
    } else {
      profile <- read_tsv(filepath, col_names = c("clade_name","ncbi_tax_id","relative_abundance"),
                          col_types = "ccd", skip = 1) %>%
        mutate(sample = sample_name)
    }
    return(profile)
  } else {
    cat(sprintf("  [Simulation] MetaPhlAn profile not found for %s — using simulated data.\n", sample_name))
    return(simulate_metaphlan_profile(sample_name))
  }
}

load_metadata <- function(filepath) {
  if (file.exists(filepath)) {
    cat(sprintf("  Loading metadata: %s\n", filepath))
    meta <- read_tsv(filepath, col_types = cols(.default = "c"))
    return(meta)
  } else {
    cat("  [Simulation] Metadata file not found — using default metadata.\n")
    meta <- tibble(
      SampleID    = c("JC1A", "JP4D"),
      condition   = c("control", "fertilized"),
      location    = c("control_mesocosm", "lagunita_pond"),
      environment = c("water", "water"),
      experiment  = c("Cuatro_Ciengas", "Cuatro_Ciengas"),
      total_reads = c(137198, 298444)
    )
    return(meta)
  }
}

cat("\n══════════════════════════════════════════════\n")
cat("  STEP 1: Loading Data\n")
cat("══════════════════════════════════════════════\n")

kraken_JC1A <- load_kraken_report(config$kraken_JC1A, "JC1A")
kraken_JP4D <- load_kraken_report(config$kraken_JP4D, "JP4D")
metaphlan_JC1A <- load_metaphlan_profile(config$metaphlan_JC1A, "JC1A")
metaphlan_JP4D <- load_metaphlan_profile(config$metaphlan_JP4D, "JP4D")
metadata <- load_metadata(config$metadata_file)

# Combine Kraken reports
kraken_all <- bind_rows(kraken_JC1A, kraken_JP4D)

# Combine MetaPhlAn profiles
metaphlan_all <- bind_rows(metaphlan_JC1A, metaphlan_JP4D)

cat("\n✓ Data loading complete.\n")

# ============================================================
# SECTION 4: DATA EXPLORATION & BASIC QC SUMMARY
# ============================================================

cat("\n══════════════════════════════════════════════\n")
cat("  STEP 2: Quality Control & Data Summary\n")
cat("══════════════════════════════════════════════\n")

summarize_kraken <- function(report, sample) {
  total    <- report %>% filter(rank == "R") %>% pull(clade_reads) %>% sum()
  if (length(total) == 0 || total == 0) {
    total <- report %>% filter(rank == "U") %>% pull(clade_reads) %>% sum()
  }
  unclass  <- report %>% filter(rank == "U") %>% pull(clade_reads) %>% sum()
  bacteria <- report %>% filter(rank == "D", str_detect(name, "Bacteria")) %>% pull(clade_reads) %>% sum()
  euk      <- report %>% filter(rank == "D", str_detect(name, "Eukaryota")) %>% pull(clade_reads) %>% sum()
  virus    <- report %>% filter(rank == "D", str_detect(name, "Viruses")) %>% pull(clade_reads) %>% sum()
  all_reads <- unclass + (report %>% filter(rank == "R") %>% pull(clade_reads) %>% sum())
  
  tibble(
    Sample = sample,
    Total_Reads = format(all_reads, big.mark = ","),
    Unclassified_pct = sprintf("%.1f%%", unclass / all_reads * 100),
    Classified_pct   = sprintf("%.1f%%", (all_reads - unclass) / all_reads * 100),
    Bacteria_pct     = sprintf("%.1f%%", bacteria / all_reads * 100),
    Eukaryota_pct    = sprintf("%.1f%%", euk / all_reads * 100),
    Virus_pct        = sprintf("%.2f%%", virus / all_reads * 100)
  )
}

qc_summary <- bind_rows(
  summarize_kraken(kraken_JC1A, "JC1A"),
  summarize_kraken(kraken_JP4D, "JP4D")
)
print(qc_summary)

# ============================================================
# SECTION 5: KRAKEN2 CLASSIFICATION ANALYSIS
# ============================================================

cat("\n══════════════════════════════════════════════\n")
cat("  STEP 3: Kraken2 Classification Analysis\n")
cat("══════════════════════════════════════════════\n")

# 5.1 — Extract domain-level composition
get_domain_composition <- function(report) {
  total_reads <- report %>%
    filter(rank == "U") %>% pull(clade_reads) %>% sum() +
    report %>% filter(rank == "R") %>% pull(clade_reads) %>% sum()
  
  domains <- report %>%
    filter(rank %in% c("U", "D")) %>%
    mutate(
      domain = case_when(
        rank == "U" ~ "Unclassified",
        str_detect(name, "Bacteria") ~ "Bacteria",
        str_detect(name, "Eukaryota") ~ "Eukaryota",
        str_detect(name, "Virus") ~ "Viruses",
        str_detect(name, "Archaea") ~ "Archaea",
        TRUE ~ "Other"
      ),
      pct_reads = clade_reads / total_reads * 100
    ) %>%
    group_by(sample, domain) %>%
    summarise(pct_reads = sum(pct_reads), .groups = "drop")
  return(domains)
}

domain_comp <- bind_rows(
  get_domain_composition(kraken_JC1A),
  get_domain_composition(kraken_JP4D)
)

# 5.2 — Extract phylum-level composition
get_phylum_composition <- function(report) {
  total_reads <- report %>%
    filter(rank == "U") %>% pull(clade_reads) %>% sum() +
    report %>% filter(rank == "R") %>% pull(clade_reads) %>% sum()
  
  phyla <- report %>%
    filter(rank == "P") %>%
    mutate(
      name = str_trim(name),
      pct_reads = clade_reads / total_reads * 100
    ) %>%
    arrange(desc(pct_reads)) %>%
    select(sample, phylum = name, pct_reads)
  return(phyla)
}

phylum_comp <- bind_rows(
  get_phylum_composition(kraken_JC1A),
  get_phylum_composition(kraken_JP4D)
)

# 5.3 — Extract class-level composition
get_class_composition <- function(report) {
  total_reads <- report %>%
    filter(rank == "U") %>% pull(clade_reads) %>% sum() +
    report %>% filter(rank == "R") %>% pull(clade_reads) %>% sum()
  
  classes <- report %>%
    filter(rank == "C") %>%
    mutate(
      name = str_trim(name),
      pct_reads = clade_reads / total_reads * 100
    ) %>%
    arrange(desc(pct_reads)) %>%
    select(sample, class = name, pct_reads)
  return(classes)
}

class_comp <- bind_rows(
  get_class_composition(kraken_JC1A),
  get_class_composition(kraken_JP4D)
)

# 5.4 — Extract species-level composition
get_species_composition <- function(report) {
  total_reads <- report %>%
    filter(rank == "U") %>% pull(clade_reads) %>% sum() +
    report %>% filter(rank == "R") %>% pull(clade_reads) %>% sum()
  
  species <- report %>%
    filter(rank == "S") %>%
    mutate(
      name = str_trim(name),
      pct_reads = clade_reads / total_reads * 100
    ) %>%
    arrange(desc(pct_reads)) %>%
    head(config$top_n_taxa) %>%
    select(sample, species = name, pct_reads)
  return(species)
}

species_comp <- bind_rows(
  get_species_composition(kraken_JC1A),
  get_species_composition(kraken_JP4D)
)

cat("✓ Kraken2 taxonomy extracted at Domain, Phylum, Class, and Species levels.\n")

# ============================================================
# SECTION 6: BRACKEN-STYLE ABUNDANCE REESTIMATION
# ============================================================

cat("\n══════════════════════════════════════════════\n")
cat("  STEP 4: Bracken-style Abundance Reestimation\n")
cat("══════════════════════════════════════════════\n")

# Bracken re-distributes reads from higher taxa down to species level
# using a Bayesian probabilistic approach. We implement a simplified
# version: redistribute unclassified reads proportionally.

bracken_redistribute <- function(report, level = "S") {
  total_reads <- report %>%
    filter(rank == "U") %>% pull(clade_reads) %>% sum() +
    report %>% filter(rank == "R") %>% pull(clade_reads) %>% sum()
  
  unclassified_reads <- report %>%
    filter(rank == "U") %>% pull(clade_reads) %>% sum()
  
  # Get target-level reads
  target_taxa <- report %>%
    filter(rank == level) %>%
    mutate(name = str_trim(name))
  
  if (nrow(target_taxa) == 0) return(tibble())
  
  # Proportionally redistribute unclassified reads
  target_sum <- sum(target_taxa$clade_reads)
  if (target_sum > 0) {
    target_taxa <- target_taxa %>%
      mutate(
        bracken_reads = clade_reads + round(unclassified_reads * clade_reads / target_sum),
        bracken_pct   = bracken_reads / total_reads * 100
      )
  } else {
    target_taxa <- target_taxa %>%
      mutate(bracken_reads = clade_reads, bracken_pct = clade_reads / total_reads * 100)
  }
  
  return(target_taxa %>% arrange(desc(bracken_reads)))
}

bracken_JC1A <- bracken_redistribute(kraken_JC1A, "S") %>% mutate(sample = "JC1A")
bracken_JP4D <- bracken_redistribute(kraken_JP4D, "S") %>% mutate(sample = "JP4D")
bracken_all  <- bind_rows(bracken_JC1A, bracken_JP4D)

cat("✓ Bracken-style redistribution complete.\n")
if (nrow(bracken_all) > 0) {
  cat(sprintf("  Species detected — JC1A: %d | JP4D: %d\n",
              nrow(bracken_JC1A), nrow(bracken_JP4D)))
}

