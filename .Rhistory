# ────────────────────────────────────────────────────────────

# Keep top 10 phyla, group rest as "Other"
top_phyla <- phylum_comp %>%
  group_by(phylum) %>%
  summarise(total = sum(pct_reads)) %>%
  arrange(desc(total)) %>%
  slice_head(n = 10) %>%
  pull(phylum)

phylum_plot_data <- phylum_comp %>%
  mutate(phylum_grp = if_else(phylum %in% top_phyla, phylum, "Other")) %>%
  group_by(sample, phylum_grp) %>%
  summarise(pct_reads = sum(pct_reads), .groups = "drop") %>%
  mutate(phylum_grp = factor(phylum_grp,
                             levels = c(top_phyla[top_phyla %in% unique(phylum_grp)], "Other")))

phylum_colors <- setNames(
  c(brewer.pal(min(10, length(top_phyla)), "Set3"), "grey70"),
  c(top_phyla[1:min(10,length(top_phyla))], "Other")
)

p_phylum <- ggplot(phylum_plot_data,
                   aes(x = sample, y = pct_reads, fill = phylum_grp)) +
  geom_bar(stat = "identity", width = 0.6, color = "white", linewidth = 0.2) +
